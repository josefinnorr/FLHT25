<Window x:Class="Rock_Paper_Scissors_Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rock_Paper_Scissors_Game"
        mc:Ignorable="d"
        Title="Rock-Paper-Scissors" Height="450" Width="800">
    <Grid Background="#FFEBE49B">

        <Label
            x:Name="lblTitle"
            Content="Rock-Paper-Scissors"
            FontWeight="Bold"
            FontFamily="Calisto MT"
            FontSize="22"
            HorizontalAlignment="Left" Margin="43,36,0,0" VerticalAlignment="Top" Height="41" Width="243"/>

        <Button 
            x:Name="btnRock"
            Content="Rock" 
            FontFamily="Arial"
            Background="Ivory"
            BorderThickness="2"
            HorizontalAlignment="Left" Margin="54,120,0,0" VerticalAlignment="Top" Height="32" Width="78" Click="btnRock_Click"/>
        <Button 
            x:Name="btnPaper"
            Content="Paper" 
            FontFamily="Arial"
            Background="Ivory"
            BorderThickness="2"
            HorizontalAlignment="Left" Margin="162,120,0,0" VerticalAlignment="Top" Height="32" Width="78" Click="btnPaper_Click"/>
        <Button 
            x:Name="btnScissors"
            Content="Scissors" 
            FontFamily="Arial"
            Background="Ivory"
            BorderThickness="2"
            HorizontalAlignment="Left" Margin="269,120,0,0" VerticalAlignment="Top" Height="32" Width="89" Click="btnScissors_Click"/>

        <ListBox 
            x:Name="lstScore"
            Margin="440,28,43,273"/>

        <TextBox 
            x:Name="txtStatus"
            BorderBrush="Black"
            BorderThickness="1"
            HorizontalAlignment="Left" Margin="54,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="232" Height="97"/>

        <TextBox 
            x:Name="txtInstructions"
            Background="Transparent"
            BorderBrush="Transparent"
            FontSize="15"
            HorizontalAlignment="Left" Margin="47,71,0,0" TextWrapping="Wrap" Text="Press one of the buttons and hope for the best!" VerticalAlignment="Top" Width="373"/>
        <ListBox 
            x:Name="lstRoundWins"
            Margin="440,187,43,49"/>

    </Grid>
</Window>
