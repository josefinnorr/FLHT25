<Window x:Class="TempConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TempConverter"
        mc:Ignorable="d"
        Background="LightCyan"
        Title="TempConverter" Height="450" Width="800">
    <Grid>
        <TextBox 
            x:Name="txtTitle"
            FontSize="25"
            FontFamily="Times New Roman"
            FontWeight="Bold"
            BorderThickness="0"
            Background="Transparent"
            TextAlignment="Center"
            HorizontalAlignment="Left" Margin="113,60,0,0" TextWrapping="Wrap" Text="TempConverter" VerticalAlignment="Top" Width="199" Height="42"/>
        <TextBox 
            x:Name="txtTemp"
            FontFamily="Times New Roman"
            BorderThickness="2"
            BorderBrush="Black"
            HorizontalAlignment="Left" Margin="130,146,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="165" Height="37"/>

        <CheckBox 
            x:Name="chkCelsius"
            FontFamily="Times New Roman"
            Content="Celsius" HorizontalAlignment="Left" Margin="130,117,0,0" VerticalAlignment="Top"/>

        <CheckBox
            x:Name="chkFahrenheit"
            FontFamily="Times New Roman"
            Content="Fahrenheit" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,117,0,0"/>

        <CheckBox 
            x:Name="chkKelvin"
            FontFamily="Times New Roman"
            Content="Kelvin" HorizontalAlignment="Left" Margin="358,117,0,0" VerticalAlignment="Top"/>

        <ListBox 
            x:Name="lstResults"
            FontFamily="Times New Roman"
             Margin="456,0,0,0"/>

        <Button 
            x:Name="btnCalc"
           Background="SteelBlue"
            BorderBrush="Black"
            BorderThickness="2"
            Content="Calculate" HorizontalAlignment="Left" Margin="164,209,0,0" VerticalAlignment="Top" Width="97" Click="btnCalc_Click"/>

    </Grid>
</Window>
