<Window x:Class="AdventWS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdventWS"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox 
            x:Name="txtSong"
            HorizontalAlignment="Center" Margin="0,102,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="288" Height="127"/>
        <Button 
            x:Name="btnCheck"
            Content="Check" HorizontalAlignment="Center" Margin="0,249,0,0" VerticalAlignment="Top" Click="btnCheck_Click"/>

    </Grid>
</Window>
