<Window x:Class="FL11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FL11"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox 
            x:Name="txtPris"
            FontSize="30"
            HorizontalAlignment="Left" Margin="147,130,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="167" Height="45"/>
        <Button 
            x:Name="btnsumma"
            Content="Buy" HorizontalAlignment="Left" Margin="189,0,0,0" VerticalAlignment="Center" Click="btnsumma_Click" Width="78"/>
        <TextBox 
            x:Name="txtTotal"
            FontSize="25"
            BorderThickness="0" Background="Transparent"
            HorizontalAlignment="Left" Margin="147,265,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120"/>
        <Button 
            x:Name="btnClear"
            Content="Clear" HorizontalAlignment="Left" Margin="459,0,0,0" VerticalAlignment="Center" Click="btnClear_Click"/>

    </Grid>
</Window>
