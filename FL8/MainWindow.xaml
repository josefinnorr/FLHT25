<Window x:Class="FL8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FL8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button 
            x:Name="btnCalculate"
            Content="Calculate" HorizontalAlignment="Left" Margin="368,176,0,0" VerticalAlignment="Top" Click="btnCalculate_Click"/>
        <TextBox 
            x:Name="txtNumberOfPassengers"
            HorizontalAlignment="Center" Margin="0,77,0,0" TextWrapping="Wrap" Text="Passengers" VerticalAlignment="Top" Width="310" Height="58"/>
        
        <Button 
            x:Name="btnQueue"
            Content="Queue" HorizontalAlignment="Left" Margin="278,176,0,0" VerticalAlignment="Top" Click="btnQueue_Click"/>

    </Grid>
</Window>
